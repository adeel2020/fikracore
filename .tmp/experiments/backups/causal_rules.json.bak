      ],
      "escalation_target": "VAS & Charging Ops",
      "prohibited_routes": ["Network L2 Core"],
      "fallback_domain": "Billing",
      "action": "Manage tunes in the du App. To unsubscribe entirely, send SMS CT UNSUB to 1560.",
      "url": "https://www.du.ae/support-articledetail?artid=PROD-12492&lang=en-GB&version=4.0&tagname=dutopic_callertunes&userType=consumer"
    },
    {
      "id": "faq_dncr",
