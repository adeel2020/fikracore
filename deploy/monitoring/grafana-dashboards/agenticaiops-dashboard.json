{
  "__inputs": [],
  "__requires": [],
  "title": "AgenticAIOPs Overview",
  "uid": "agenticaiops-overview",
  "panels": [
    {
      "title": "QPS by Agent",
      "type": "graph",
      "targets": [
        {
          "expr": "sum by(agent) (rate(http_requests_total[1m]))"
        }
      ]
    },
    {
      "title": "P95 Latency by Endpoint",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le, endpoint) (rate(http_request_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "title": "Error Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(http_errors_total[5m])"
        }
      ]
    },
    {
      "title": "Active Agent Pods",
      "type": "stat",
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{phase=\"Running\"})"
        }
      ]
    },
    {
      "title": "Model Response Time",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(model_inference_duration_seconds_sum[5m]) / rate(model_inference_duration_seconds_count[5m])"
        }
      ]
    },
    {
      "title": "Qdrant Query Latency",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(qdrant_request_duration_seconds_sum[5m]) / rate(qdrant_request_duration_seconds_count[5m])"
        }
      ]
    }
  ]
}
