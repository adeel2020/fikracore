{
  "faqs": [
    {
      "id": "faq_amazon_prime_cancel",
      "keywords": ["cancel amazon prime", "unsubscribe prime", "cancel prime", "cancel my amazon prime", "cancel my prime", "cancel amazon", "amazon prime cancel"],
      "label": "Cancel Amazon Prime Subscription",
      "mandatory_prechecks": [
        "Check BSS profile status",
        "Verify subscription is postpaid"
      ],
      "escalation_target": "Billing & Accounts L2",
      "prohibited_routes": ["Network L2 Core", "RAN Engineering"],
      "fallback_domain": "Billing",
      "action": "Log in to du My Account app/portal, navigate to active Add-ons, and toggle off Amazon Prime.",
      "url": "https://www.du.ae/support-articledetail?artid=PROD-52779&lang=en-GB&version=6.0&tagname=dutopic_amazonprime&userType=consumer"
    },
    {
      "id": "faq_amazon_prime_activate",
      "keywords": ["activate amazon prime", "get prime", "free prime offer", "activate my amazon prime", "activate prime", "activate amazon", "amazon prime activate"],
      "label": "Activate 12 Months Free Amazon Prime",
      "mandatory_prechecks": [
        "Check BSS profile status",
        "Verify plan eligibility"
      ],
      "escalation_target": "eSIM & Provisioning Support",
      "prohibited_routes": ["RAN Engineering", "Billing L2"],
      "fallback_domain": "Provisioning",
      "action": "Send SMS keyword Prime to 9511 from an eligible postpaid or home plan line, then register via the SMS link.",
      "url": "https://www.du.ae/support-articledetail?artid=PROD-52779&lang=en-GB&version=6.0&tagname=dutopic_amazonprime&userType=consumer"
    },
    {
      "id": "faq_call_barring",
      "keywords": ["barring", "bar calls", "call bar"],
      "label": "Call Barring Management",
      "mandatory_prechecks": [
