      "mandatory_prechecks": [
        "Verify HLR subscriber voice status"
      ],
      "escalation_target": "Network L2 Core Support",
      "prohibited_routes": ["eSIM & Provisioning Support"],
      "fallback_domain": "Network",
      "action": "Dial short codes: *21*Destination_Number# (Always), *61*Number# (No Reply), *62*Number# (Unreachable). Dial ##21# to cancel.",
      "url": "https://www.du.ae/support-articledetail?artid=PROD-12489&lang=en-GB&version=4.0&tagname=dutopic_callforwarding&userType=consumer"
    },
    {
